+++
version = 1
[interpretation]
mode = "semantic"
[runtime]
judgment = "semantic"
[budget.run]
requests = 8
timeout = "30s"
+++
# Start with Analyze: inspect how these sentences become executable operations.
# Run then asks Jev which tickets meet our criterion. Inspect Trace for usage.
# Requires TYPESAFE_API_KEY in Studio's working directory .env or environment.
criterion urgent:
  ask "Does this ticket describe an active service outage or active incorrect customer charges requiring immediate action?"
  using message
  accept probability at least 0.85
  on uncertain discard

make tickets [{"id": 1, "team": "payments", "message": "Checkout is down now. Nobody can pay."}, {"id": 2, "team": "design", "message": "Please add a purple theme someday. Everything works."}, {"id": 3, "team": "payments", "message": "Every purchase is charging customers twice right now."}]
# Jev chooses a supported meaning for this sentence; Analyze shows its decision.
filter tickets where team is "payments"
# A declared adjective introduces runtime judgment without an explicit jev call.
keep urgent tickets
display tickets as table with id, team, message
