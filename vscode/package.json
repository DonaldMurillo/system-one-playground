{
  "name": "sysonescript-vscode",
  "displayName": "SysOneScript",
  "description": "Language support for SysOneScript (.sos) with the native SysOneScript language server.",
  "version": "0.4.1",
  "publisher": "donaldmurillo",
  "packageManager": "pnpm@9.15.9",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DonaldMurillo/system-one-playground"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "SysOneScript executes project files and configured helpers; trust is required before activation."
    }
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "SysOneScript",
    "SOS",
    "language server",
    "LSP"
  ],
  "activationEvents": [
    "onLanguage:sos",
    "onView:sysonescript.project",
    "onView:sysonescript.streams",
    "onCommand:sysonescript.selectEntrypoint",
    "onCommand:sysonescript.runProject",
    "onCommand:sysonescript.runFile",
    "onCommand:sysonescript.debugFile",
    "onCommand:sysonescript.debugProject",
    "onCommand:sysonescript.showRunOutput",
    "onCommand:sysonescript.stopStream",
    "onCommand:sysonescript.refreshStreams",
    "onCommand:sysonescript.showStreamsOutput",
    "onCommand:sysonescript.checkProject",
    "onCommand:sysonescript.buildProject",
    "onCommand:sysonescript.explainFile",
    "onCommand:sysonescript.canonicalizeFile",
    "onCommand:sysonescript.canonicalizeLine",
    "onCommand:sysonescript.stop",
    "onCommand:sysonescript.setJevToken",
    "onCommand:sysonescript.clearJevToken",
    "onCommand:sysonescript.showJevStatus",
    "onCommand:sysonescript.selectIconTheme",
    "onCommand:sysonescript.openWelcome",
    "onCommand:sysonescript.getCli",
    "onCommand:sysonescript.updateCli",
    "onCommand:sysonescript.checkCliVersions",
    "onCommand:sysonescript.refresh",
    "onCommand:sysonescript.runHelper"
	,"onCommand:sysonescript.moduleOpen"
	,"onCommand:sysonescript.moduleCheck"
	,"onCommand:sysonescript.moduleDoctor"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "lsp-client.js",
    "project.js",
    "semantic.js",
    "streams.js",
    "streams-server.js",
    "bin/**",
    "icon.png",
    "icons/**",
    "walkthrough/**",
    "language-configuration.json",
    "syntaxes/**",
    "README.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check extension.js && node --check lsp-client.js && node --check project.js && node --check semantic.js && node --check streams.js && node --check streams-server.js && node --check test/*.js",
    "test": "node --test test/*.test.js",
    "prepackage": "node test/build-runtime.js",
    "package": "pnpm exec vsce package --no-dependencies --allow-unused-files-pattern",
    "package:smoke": "node test/package-smoke-current.js"
  },
  "contributes": {
    "walkthroughs": [
      {
        "id": "sysonescript.getStarted",
        "title": "Get Started with SysOneScript",
        "description": "Write, run, debug, and configure SysOneScript without installing Go or a separate runtime.",
        "steps": [
          {
            "id": "sysonescript.getStarted.openPanel",
            "title": "Open the project controls",
            "description": "Use the SysOneScript Activity Bar panel for project-level Run, Check, Build, Debug, output, and helper actions.\n[Open SysOneScript Project](command:workbench.view.extension.sysonescript)",
            "media": {
              "markdown": "./walkthrough/project.md"
            }
          },
          {
            "id": "sysonescript.getStarted.run",
            "title": "Run your project",
            "description": "Run the detected project entrypoint and see the complete result in the SysOneScript Run output channel.\n[Run Project](command:sysonescript.runProject)",
            "media": {
              "markdown": "./walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:sysonescript.runProject"
            ]
          },
          {
            "id": "sysonescript.getStarted.debug",
            "title": "Debug with native VS Code tools",
            "description": "Set breakpoints, step through statements, inspect locals, and evaluate expressions.\n[Debug Project](command:sysonescript.debugProject)",
            "media": {
              "markdown": "./walkthrough/debug.md"
            },
            "completionEvents": [
              "onCommand:sysonescript.debugProject"
            ]
          },
          {
            "id": "sysonescript.getStarted.jev",
            "title": "Enable Jev features",
            "description": "Store the optional Jev token in VS Code SecretStorage for model-backed language features.\n[Set Jev Token](command:sysonescript.setJevToken)",
            "media": {
              "markdown": "./walkthrough/jev.md"
            },
            "completionEvents": [
              "onCommand:sysonescript.setJevToken"
            ]
          },
          {
            "id": "sysonescript.getStarted.cli",
            "title": "Get the standalone CLI",
            "description": "The extension already includes everything VS Code needs. Download the optional `sysone` and `sos` terminal commands separately when you want them on your PATH.\n[Open CLI Downloads](command:sysonescript.getCli)",
            "media": {
              "markdown": "./walkthrough/cli.md"
            },
            "completionEvents": [
              "onCommand:sysonescript.getCli"
            ]
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "sos",
        "aliases": [
          "SysOneScript",
          "SOS"
        ],
        "extensions": [
          ".sos"
        ],
        "icon": {
          "light": "./icons/sysonescript-file.svg",
          "dark": "./icons/sysonescript-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sysonescript",
          "title": "SysOneScript",
          "icon": "./icons/sysonescript-glyph.svg"
        }
      ]
    },
    "views": {
      "sysonescript": [
        {
          "id": "sysonescript.project",
          "name": "Project",
          "contextualTitle": "SysOneScript Project"
        },
        {
          "id": "sysonescript.streams",
          "name": "Streams",
          "contextualTitle": "SysOneScript Streams"
        }
      ]
    },
    "iconThemes": [
      {
        "id": "sysonescript-icons",
        "label": "SysOneScript Icons",
        "path": "./icons/sysonescript-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "sos",
        "scopeName": "source.sos",
        "path": "./syntaxes/sos.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "sosOperator",
        "superType": "keyword",
        "description": "SysOneScript expression and sentence operator"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "sos",
        "scopes": {
          "sosOperator": [
            "keyword.control.operator.sos"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "sysonescript.analyze",
        "title": "SysOneScript: Analyze Document",
        "shortTitle": "Analyze",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.restartServer",
        "title": "SysOneScript: Restart Language Server",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.selectEntrypoint",
        "title": "SysOneScript: Select Project Entrypoint",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.runProject",
        "title": "SysOneScript: Run Project",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.runFile",
        "title": "SysOneScript: Run File",
        "shortTitle": "Run",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.checkProject",
        "title": "SysOneScript: Check Project",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.buildProject",
        "title": "SysOneScript: Build Project",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.explainFile",
        "title": "SysOneScript: Explain File",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.canonicalizeFile",
        "title": "SysOneScript: Make File Canonical",
        "shortTitle": "Canonicalize",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.canonicalizeLine",
        "title": "SysOneScript: Make Interpreted Line Canonical",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.debugProject",
        "title": "SysOneScript: Debug Project",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.debugFile",
        "title": "SysOneScript: Debug File",
        "shortTitle": "Debug",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.stop",
        "title": "Stop SOS",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.showRunOutput",
        "title": "SysOneScript: Show Run Output",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.stopStream",
        "title": "Stop Stream",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.refreshStreams",
        "title": "Refresh Streams",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.showStreamsOutput",
        "title": "Show Stream Lifecycle",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.setJevToken",
        "title": "SysOneScript: Set Jev Token",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.clearJevToken",
        "title": "SysOneScript: Clear Jev Token",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.showJevStatus",
        "title": "SysOneScript: Show Jev Token Status",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.selectIconTheme",
        "title": "SysOneScript: Choose Explorer Icon Theme",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.refresh",
        "title": "SysOneScript: Refresh Project Panel",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.runHelper",
        "title": "SysOneScript: Run Helper",
        "category": "SysOneScript"
      },
	  {
		"command": "sysonescript.moduleOpen",
		"title": "SysOneScript: Open Module Definition",
		"category": "SysOneScript"
	  },
	  {
		"command": "sysonescript.moduleCheck",
		"title": "SysOneScript: Check External Module",
		"category": "SysOneScript"
	  },
	  {
		"command": "sysonescript.moduleDoctor",
		"title": "SysOneScript: Diagnose External Module",
		"category": "SysOneScript"
	  },
      {
        "command": "sysonescript.openWelcome",
        "title": "SysOneScript: Open Welcome",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.getCli",
        "title": "SysOneScript: Get Standalone CLI",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.updateCli",
        "title": "SysOneScript: Update Standalone CLI",
        "category": "SysOneScript"
      },
      {
        "command": "sysonescript.checkCliVersions",
        "title": "SysOneScript: Check CLI Version Sync",
        "category": "SysOneScript"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sysonescript.canonicalizeFile",
          "when": "editorLangId == sos",
          "group": "navigation@8"
        },
        {
          "command": "sysonescript.analyze",
          "when": "editorLangId == sos",
          "group": "navigation@9"
        },
        {
          "command": "sysonescript.runFile",
          "when": "editorLangId == sos",
          "group": "navigation@10"
        },
        {
          "command": "sysonescript.debugFile",
          "when": "editorLangId == sos",
          "group": "navigation@11"
        }
      ],
      "editor/context": [
        {
          "command": "sysonescript.canonicalizeFile",
          "when": "resourceLangId == sos",
          "group": "navigation@0"
        },
        {
          "command": "sysonescript.runFile",
          "when": "resourceLangId == sos",
          "group": "navigation@1"
        },
        {
          "command": "sysonescript.debugFile",
          "when": "resourceLangId == sos",
          "group": "navigation@2"
        },
        {
          "command": "sysonescript.explainFile",
          "when": "resourceLangId == sos",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "sysonescript.runFile",
          "when": "resourceExtname == .sos",
          "group": "navigation@1"
        },
        {
          "command": "sysonescript.debugFile",
          "when": "resourceExtname == .sos",
          "group": "navigation@2"
        },
        {
          "command": "sysonescript.explainFile",
          "when": "resourceExtname == .sos",
          "group": "navigation@3"
        },
        {
          "command": "sysonescript.runProject",
          "when": "resourceFilename == sos.toml",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "sysonescript.stop",
          "when": "view == sysonescript.project && sysonescript.processRunning",
          "group": "navigation@1"
        },
        {
          "command": "sysonescript.refresh",
          "when": "view == sysonescript.project",
          "group": "navigation@2"
        },
        {
          "command": "sysonescript.refreshStreams",
          "when": "view == sysonescript.streams",
          "group": "navigation@1"
        },
        {
          "command": "sysonescript.showStreamsOutput",
          "when": "view == sysonescript.streams",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sysonescript.stopStream",
          "when": "view == sysonescript.streams && viewItem == stream",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "sysonescript.canonicalizeLine",
          "when": "false"
        },
        {
          "command": "sysonescript.stopStream",
          "when": "false"
        },
        {
          "command": "sysonescript.canonicalizeFile",
          "when": "editorLangId == sos"
        },
        {
          "command": "sysonescript.analyze",
          "when": "editorLangId == sos"
        },
        {
          "command": "sysonescript.runProject"
        },
        {
          "command": "sysonescript.runFile",
          "when": "editorLangId == sos"
        },
        {
          "command": "sysonescript.debugProject"
        },
        {
          "command": "sysonescript.debugFile",
          "when": "editorLangId == sos"
        },
        {
          "command": "sysonescript.setJevToken"
        },
        {
          "command": "sysonescript.clearJevToken"
        },
        {
          "command": "sysonescript.checkProject"
        },
        {
          "command": "sysonescript.buildProject"
        },
        {
          "command": "sysonescript.showRunOutput"
        },
        {
          "command": "sysonescript.showJevStatus"
        },
        {
          "command": "sysonescript.openWelcome"
        },
        {
          "command": "sysonescript.getCli"
        },
        {
          "command": "sysonescript.updateCli"
        },
        {
          "command": "sysonescript.checkCliVersions"
        },
        {
          "command": "sysonescript.moduleOpen"
        },
        {
          "command": "sysonescript.moduleCheck"
        },
        {
          "command": "sysonescript.moduleDoctor"
        }
      ]
    },
    "debuggers": [
      {
        "type": "sysonescript",
        "label": "SysOneScript",
        "languages": [
          "sos"
        ],
        "enableBreakpointsFor": [
          "sos"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "SysOneScript file to debug."
              },
              "cwd": {
                "type": "string",
                "description": "Project working directory."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Script arguments."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              },
              "model": {
                "type": "string"
              },
              "maxCalls": {
                "type": "number"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sysonescript",
            "request": "launch",
            "name": "Debug SysOneScript",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "sos"
      }
    ],
    "configuration": {
      "title": "SysOneScript",
      "properties": {
        "sysonescript.server.command": {
          "type": "string",
          "default": "",
          "description": "Executable used to start the SysOneScript language server. Empty uses the bundled binary in a Marketplace install, then looks for sos on PATH."
        },
        "sysonescript.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the SysOneScript language-server executable."
        },
        "sysonescript.server.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for the language server. Relative paths are resolved from the first workspace folder; empty uses that folder automatically."
        },
        "sysonescript.server.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": "Environment variables for the language server. Set a value to null to remove an inherited variable."
        },
        "sysonescript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Do not write JSON-RPC traffic to the output channel.",
            "Write request and response method names to the output channel.",
            "Write complete JSON-RPC messages to the output channel."
          ],
          "default": "off",
          "description": "Trace communication with the SysOneScript language server."
        },
        "sysonescript.runner.command": {
          "type": "string",
          "default": "",
          "description": "Executable used for SysOneScript run, build, and debug commands. Empty uses the bundled sos binary, then PATH."
        },
        "sysonescript.project.entry": {
          "type": "string",
          "default": "",
          "description": "Project-relative .sos entrypoint used by panel Run, Check, Build, and Debug actions. Empty auto-detects or prompts."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "3.6.2",
    "saxes": "6.0.0"
  }
}
