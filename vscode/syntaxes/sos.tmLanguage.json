{
  "name": "SysOneScript",
  "scopeName": "source.sos",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#failureTypes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#judgments"
    },
    {
      "include": "#literals"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sos",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sos",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sos"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sos"
            }
          },
          "patterns": [
            {
              "include": "#interpolations"
            },
            {
              "name": "constant.character.escape.sos",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolations": {
      "patterns": [
        {
          "name": "meta.interpolation.sos",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.sos"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.sos"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#literals"
            },
            {
              "name": "variable.other.readwrite.sos",
              "match": "\\b[A-Za-z_][A-Za-z0-9_-]*\\b"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.sos",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|[hms])?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sos",
          "match": "\\b(?:evaluate|criterion|package|import|export|define|failure|argument|option|switch|to|call|returning|streaming|stream|send|close|collect|may|finish|fail|recover|capture|return|while|repeat|set|emit|judge|score|command|describe|expect|remember|find|read|require|keep|sort|group|create|make|assign|when|take|classify|append|save|show|for|map|stop|print|wait|allow|advance)\\b"
        },
        {
          "name": "keyword.control.operator.sos",
          "match": "\\b(?:each|in|as|into|on|failure|called|with|where|by|from|under|named|matching|if|missing|numbered|otherwise|and|or|not|of|count|first|last|items|default|choices|is|ascending|descending|existing|off|at|most|running|collecting|failures|rethrow|pass|recover|using|reading|plus|minus|times|until|every|tick|scheduled|zone|combining|skipping|catching)\\b"
        },
        {
          "name": "keyword.control.operator.sos",
          "match": "(?<!\\+)\\+(?!\\+)|(?<!-)\\-(?!-)|[*/%]|(?:==|!=|<=|>=|<|>)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.sos",
          "match": "\\b(?:optional|text|timestamp|duration|folder|list|json|table|number|integer|boolean|switch|[A-Z][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "failureTypes": {
      "patterns": [
        {
          "name": "meta.declaration.failure.sos",
          "match": "\\b(define)(\\s+)(failure)(\\s+)([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.sos" },
            "3": { "name": "keyword.control.sos" },
            "5": { "name": "entity.name.type.failure.sos" }
          }
        },
        {
          "name": "meta.failure.contract.sos",
          "begin": "\\bmay\\s+fail\\s+with\\b",
          "beginCaptures": { "0": { "name": "keyword.control.sos" } },
          "end": "$",
          "patterns": [
            { "name": "entity.name.type.failure.sos", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
            { "name": "punctuation.separator.comma.sos", "match": "," }
          ]
        }
      ]
    },
    "judgments": {
      "patterns": [
        {
          "name": "support.function.sos",
          "match": "\\b(?:jev|classify|judge|confidence|value|p_yes|noul|choice|score)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.sos",
          "match": "\\b(?:true|false|null|now)\\b"
        }
      ]
    }
  }
}
